{
  "name": "dsh-xmm-ai",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "description": "Expose the WorkBuddy models connected by dsh-connect-workbuddy as an OpenAI-compatible HTTP API, with a sidebar settings page.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
